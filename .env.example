# PLANTILLA DE VARIABLES DE ENTORNO
# Copia este archivo como '.env' e ingresa tus credenciales reales.

# Credenciales de Acceso a la Plataforma GIS (Apache Superset)
GIS_BASE_URL=https://bi.example-gis-platform.com
GIS_USERNAME=tu_usuario@ejemplo.com
GIS_PASSWORD=tu_contrasena

# Configuración de Destino en Airtable (Personal Access Token e IDs Inmutables)
AIRTABLE_TOKEN=patXXXXXXXXXXXXXXXX.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_ID=tblXXXXXXXXXXXXXX